# escrow-policy-signer — copy to .env on the signer host (gitignored, chmod 600).
#
# Nothing here is optional. Every cap is required and a missing one refuses to start; the
# only way to switch a window off is the literal `unlimited`, which is announced at boot.

# The hot key. NOT the treasury. Authorized in AIMarketEscrow.authorizedHubs and holding
# only gas. Generate it off this host and never let the treasury key near this file.
SIGNER_PRIVATE_KEY=0x...

# Shared secret the hub sends as `Authorization: Bearer`. Second layer only — the tunnel is
# the first. Rotate by changing it here and in the hub's AIMARKET_ESCROW_SIGNER_TOKEN.
SIGNER_TOKEN=

# Where the hub posts. Must match AIMARKET_ESCROW_SIGNER_URL exactly: the client appends
# nothing and this service never redirects.
SIGNER_SIGN_PATH=/sign
SIGNER_BIND_HOST=0.0.0.0
SIGNER_BIND_PORT=9500

# This service's OWN view of chain. Never the hub's endpoints — every fact it checks is one
# the caller would like to supply. Note Base's public endpoint answers 403 without a
# User-Agent, which is why this service always sends one.
SIGNER_RPC_URLS=https://mainnet.base.org,https://base.llamarpc.com
SIGNER_RPC_TIMEOUT_S=10

# Fees. maxFee = min(2*baseFee + tip, ceiling); over the ceiling the service refuses (503)
# rather than queueing at any price. Base runs at ~0.006 gwei, so these are generous.
SIGNER_PRIORITY_FEE_WEI=1000000
SIGNER_MAX_FEE_WEI_CEILING=2000000000

# Spend windows, in USDC base units (6 dp): 10_000 = $0.01, 1_000_000 = $1.
SIGNER_CAP_UNITS_PER_TX=1000000
SIGNER_CAP_UNITS_10M=2000000
SIGNER_CAP_UNITS_1H=5000000
SIGNER_CAP_UNITS_24H=25000000
SIGNER_CAP_UNITS_CHANNEL_24H=10000000

# Counts. These are the ONLY bound on griefing that costs no dollars — receipt burning and
# nonce grinding are invisible to the USD caps.
SIGNER_CAP_TX_1H=60
SIGNER_CAP_TX_24H=400
SIGNER_CAP_TX_PER_CHANNEL_24H=50
SIGNER_CAP_DISTINCT_CHANNELS_24H=50

# Gas is a separate drain from USDC: the USD caps are denominated in the token, the key's
# ETH is what pays for the transactions. 0.002 ETH ~= 2e15 wei.
SIGNER_CAP_FEE_WEI_24H=500000000000000

# Optional: append the audit chain head where a compromise of this host cannot rewrite it.
SIGNER_AUDIT_WITNESS_PATH=
